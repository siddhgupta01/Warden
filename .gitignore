# Terraform
# Never commit state; it can contain secrets and resource metadata.
*.tfstate
*.tfstate.*
crash.log
crash.*.log

# Local Terraform working dirs and plan output
**/.terraform/*
*.tfplan
plan.out

# Variable files may hold account IDs or secrets. Commit only *.example.
*.tfvars
*.tfvars.json
!*.tfvars.example

# Keep the dependency lock file (.terraform.lock.hcl) committed.

# Backend config holds the account-ID-bearing bucket name. Commit only .example.
backend.hcl
**/backend.hcl
!**/backend.hcl.example

# Secrets and credentials
.env
.env.*
!.env.example
*.pem
*.key
aws-credentials*
credentials
id_rsa*

# Warden-generated local output (reports, dashboards, remediation files) can
# contain real resource identifiers from a scanned account. Never commit.
.warden/
findings.md
findings.json
warden-findings*
dashboard.html
gitleaks-report*.json

# Python (agent, later milestones)
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
*.egg-info/

# OS and editor
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
