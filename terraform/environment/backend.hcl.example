# Copy this file to backend.hcl (git-ignored) and fill in the values printed by
# the bootstrap module:
#
#   cd ../bootstrap && terraform output
#
# The real backend.hcl stays out of git because the bucket name contains your
# AWS account ID.

bucket         = "warden-tfstate-<ACCOUNT_ID>-us-east-1"
key            = "environment/terraform.tfstate"
region         = "us-east-1"
dynamodb_table = "warden-tf-locks"
encrypt        = true
