# Normalize line endings so diffs stay clean across Windows and Linux.
# Text files are stored with LF in the repo and checked out natively.
* text=auto eol=lf

# Windows scripts keep CRLF.
*.bat text eol=crlf
*.ps1 text eol=crlf

# Treat common binaries as binary.
*.png binary
*.jpg binary
*.gif binary
*.pdf binary
*.zip binary
